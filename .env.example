# API (runtime). Never commit a real .env.
# Set a local connection string; there is no default database credential.
DATABASE_URL=
# Set a local random secret before starting the API or Compose; Compose rejects an empty value.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
PORT=3000
# Web (build time, PUBLIC — never put secrets here): see web/.env.example
# Optional: failed sign-ins allowed per email+IP per 15 min (default 10); set TRUST_PROXY (e.g. 1) only behind a proxy you control
LOGIN_MAX_FAILURES=10
#TRUST_PROXY=1
